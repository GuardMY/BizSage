# API
API_PORT=8080
JWT_SECRET=change-me-v1-dev-secret-change-me
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AI_WORKER_URL=http://localhost:8100
COLLECTOR_URL=http://localhost:8200

# Database
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bizsage
MYSQL_USER=bizsage
MYSQL_PASSWORD=bizsage

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379

# Vector storage
QDRANT_URL=http://localhost:16333

# LLM — 使用 DeepSeek（兼容 OpenAI SDK，设置 base_url 指向 DeepSeek）
LLM_PROVIDER=deepseek
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=sk-your-deepseek-api-key
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash

# Web
# nginx 反向代理后，浏览器同源访问，只需相对路径
NEXT_PUBLIC_API_BASE_URL=/api
