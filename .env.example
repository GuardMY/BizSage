# API
API_PORT=8080
JWT_SECRET=change-me-v1-dev-secret-change-me
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
AI_WORKER_URL=http://localhost:8100
COLLECTOR_URL=http://localhost:8200
BIZSAGE_FLYWAY_ENABLED=false

# External database
MYSQL_HOST=host.docker.internal
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bizsage
MYSQL_USER=bizsage
MYSQL_PASSWORD=bizsage
DB_URL=jdbc:mysql://host.docker.internal:13306/bizsage?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# External Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=16379

# External vector storage
QDRANT_URL=http://host.docker.internal:16333

# LLM provider
LLM_PROVIDER=deepseek
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=sk-your-deepseek-api-key
OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash

# Web
NGINX_PORT=80
NEXT_PUBLIC_API_BASE_URL=/api
